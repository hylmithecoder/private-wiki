# Rust service settings (loaded by the Makefile).

# Key for logging in to the web UI. Reading is public; creating, editing,
# deleting and restoring pages need this key. Leave empty = read-only UI.
# Generate one with: head -c 24 /dev/urandom | base64
WIKI_ADMIN_KEY=

# Key for remote MCP over HTTP at /mcp (for tunnels / claude.ai).
# Leave empty = /mcp disabled; local stdio MCP always works.
# Generate one with: head -c 32 /dev/urandom | base64
WIKI_MCP_KEY=

WIKI_ADDR=127.0.0.1:4220
# WIKI_DB=/absolute/path/to/wiki.db   # default: ~/.local/share/trpl3c-wiki/wiki.db
# WIKI_SECURE_COOKIE=1                # set when served over HTTPS
